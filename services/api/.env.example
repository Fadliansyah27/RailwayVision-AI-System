# API-local overrides. Local development only. Do not commit real credentials.
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://railwayvision:change-me-local@postgres:5432/railwayvision
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_JSON_BODY_BYTES=1048576
ENABLE_HSTS=false
JWT_SECRET=local-development-only-jwt-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SEED_SYNTHETIC_DATA=true
SEED_PASSWORD=change-me-local-synthetic-password
