# RailwayVision AI — local development environment
# Copy to .env and change every value marked change-me.
# This file contains LOCAL DEVELOPMENT values only. Never reuse them outside
# your machine, and never commit a populated .env.

APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=railwayvision
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=railwayvision

# Redis (internal Docker network only, port bound to 127.0.0.1 for tooling)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
HEARTBEAT_REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible private object storage)
MINIO_ROOT_USER=railwayvision
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_MEDIA_BUCKET=railwayvision-media
MINIO_QUARANTINE_BUCKET=railwayvision-quarantine
MEDIA_MAX_BYTES=10485760
SYNTHETIC_AI_ENABLED=true

# Web — leave empty to use the same-origin proxy in apps/web/next.config.ts.
NEXT_PUBLIC_API_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# API hardening
MAX_JSON_BODY_BYTES=1048576
ENABLE_HSTS=false
JWT_SECRET=local-development-only-jwt-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SEED_SYNTHETIC_DATA=true
# Local synthetic accounts only. Never reuse outside local development.
SEED_PASSWORD=change-me-local-synthetic-password
